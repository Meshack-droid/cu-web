# TUMCU production environment
# Copy to .env on the deployment server and replace every placeholder.

DB_NAME=tecump
DB_USER=tecump
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# The public URL of the site, for example https://tumcu.example.org
CORS_ORIGIN=https://YOUR-TUMCU-DOMAIN

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TUMCU Christian Union <no-reply@tumcu.ac.ke>
